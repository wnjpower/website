# ─────────────────────────────────────────────
#  우앤주전력 웹사이트 환경변수 템플릿
#  실제 사용 시: cp .env.example .env.local 후 값 채우기
#  .env.local은 절대 git에 커밋하지 말 것
# ─────────────────────────────────────────────

# Supabase — 신규 계정에 프로젝트 생성 후 값 입력.
# (https://supabase.com → Project Settings → API Keys)
#
# 이 앱은 anon(publishable) 키로 INSERT만 한다. service_role 키는 쓰지 않으므로
# 넣을 필요가 없다. (조회는 Supabase 대시보드 Table Editor에서)
#
# ⚠️ 키를 넣기 전에 supabase/schema.sql 을 SQL Editor에서 실행할 것.
#    특히 3번 섹션의 `grant insert ... to anon` 이 빠지면 테이블은 생기지만
#    INSERT가 권한 오류로 거부된다. (2026-04-28부터 신규 프로젝트는
#    public 스키마 테이블이 Data API에 자동 노출되지 않음)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# service_role 키 — **실시간 알림(웹 푸시) 기능에만** 쓰인다. 없으면 알림만 꺼지고
# 나머지 기능은 전부 정상 동작한다.
#
# 왜 필요한가: 방문자가 CTA 버튼을 누른 시점의 요청 주체는 로그인하지 않은 방문자다.
# 그 요청에서 "알림 받을 기기 목록"을 읽어야 하는데, 익명(anon)에게 그 테이블을 열면
# 사장님 기기의 푸시 주소가 공개된다. 그래서 발송 경로(lib/push/*)만 이 키를 쓴다.
#
# ⚠️ 이 키는 RLS를 전부 우회한다. 서버 환경변수로만 두고 절대 클라이언트 코드에서
#    참조하지 말 것 (NEXT_PUBLIC_ 접두어를 붙이면 즉시 유출된다).
SUPABASE_SERVICE_ROLE_KEY=

# Resend — 계정 이관으로 기존 키/도메인 인증 재사용 안 함. 신규 계정에서 재설정 예정.
# 미설정 상태여도 요청은 실패하지 않음(app/api/quote/route.ts에서 try/catch로 무시됨)
# (https://resend.com)
# 1) resend.com → API Keys → Create API Key
# 2) resend.com → Domains → Add Domain(wnjpower.com) → DNS 레코드 추가 후 인증
RESEND_API_KEY=re_xxx
NOTIFY_TO_EMAIL=wnj-2023@naver.com
NOTIFY_FROM_EMAIL=quote@wnjpower.com

# ─── 카카오 알림톡 (Solapi) ───────────────────────────────────────────────────
# 설정 완료 전까지는 이 섹션을 비워두면 알림톡 없이 이메일만 발송됨.
#
# [설정 순서]
# 1. 카카오 비즈니스 채널 개설 → https://business.kakao.com
#    채널 유형을 '공개 채널'로 전환 + 비즈니스 인증 완료
# 2. Solapi 가입 → https://console.solapi.com
#    [API Key 관리] → API Key / Secret 발급
#    [카카오 채널] → 채널 연동 (채널 검색 ID: @우앤주전력)
#    [알림톡 템플릿] → 아래 두 템플릿 등록 후 카카오 심사 (1~3 영업일)
# 3. 발신번호 등록: [발신번호 관리] → 010-8552-9994 등록 (본인인증 문자)
# 4. 아래 값 입력 후 저장
#
# [알림톡 템플릿 내용 — Solapi 대시보드에 그대로 붙여넣기]
#
# ▶ 신청자 수신용 (SOLAPI_TEMPLATE_TO_REQUESTER):
# ────────────────────────────────────────────
# [우앤주전력] 견적문의 접수 완료
#
# 안녕하세요, #{성함}님.
# 우앤주전력에 견적문의가 정상 접수되었습니다.
#
# ■ 접수 내용
# - 공사 종류: #{공사종류}
# - 접수 일시: #{접수일시}
#
# 1영업일 이내에 담당자가 직접 연락드리겠습니다.
#
# 빠른 연락: 010-8552-9994
# wnjpower.com
# ────────────────────────────────────────────
#
# ▶ 사장님 수신용 (SOLAPI_TEMPLATE_TO_OWNER):
# ────────────────────────────────────────────
# [우앤주전력] 새 견적문의 접수
#
# 고객 문의가 접수되었습니다.
#
# ■ 고객 정보
# - 업체명: #{업체명}
# - 성함: #{성함}
# - 연락처: #{연락처}
# - 공사 종류: #{공사종류}
# - 지역: #{지역}
# - 접수 일시: #{접수일시}
#
# 고객에게 빠른 연락 부탁드립니다!
# ────────────────────────────────────────────

SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=              # Solapi 채널연동 후 발급되는 발신프로필 ID (KA01PF...)
SOLAPI_SENDER_NUMBER=010-8552-9994
SOLAPI_TEMPLATE_TO_REQUESTER=   # 신청자에게 보내는 템플릿 ID (KA01TP...)
SOLAPI_TEMPLATE_TO_OWNER=       # 사장님에게 보내는 템플릿 ID (KA01TP...)
OWNER_MOBILE=010-8552-9994

# ─── 실시간 알림 (웹 푸시) ──────────────────────────────────────────────────
# 방문자가 사이트의 CTA 버튼(전화·카카오톡·견적문의 등)을 누르면 사장님 휴대폰·PC에
# 알림 팝업이 즉시 뜬다. 브라우저 표준 기능이라 별도 비용이 없다.
#
# [설정 순서]
# 1. npm run push:keys  →  아래 두 값을 출력해 준다 (한 번만 만들고 계속 쓴다)
# 2. Supabase SQL Editor에서 supabase/push-schema.sql 실행
# 3. 위 SUPABASE_SERVICE_ROLE_KEY 까지 채운 뒤 Vercel에 입력 → 재배포
# 4. 배포 후 /admin/notifications 에서 기기마다 [이 기기에서 알림 받기]
#    - 아이폰·아이패드는 사파리에서 [공유] → [홈 화면에 추가] 후, 그 아이콘으로
#      들어와서 켜야 한다 (iOS 16.4+ 애플 정책). 안드로이드·PC는 그냥 켜면 된다.
#
# ⚠️ 키를 나중에 바꾸면 이미 등록된 기기의 구독이 전부 무효가 되어, 각 기기에서
#    알림을 다시 켜야 한다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 발생 시 연락할 주소. 비우면 회사 대표 메일이 쓰인다.
VAPID_SUBJECT=mailto:wnj-2023@naver.com

# (선택) Cloudflare Turnstile — 봇 방지
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# (선택) Google Analytics 4 — 미설정이어도 components/GoogleAnalytics.tsx의 기본값으로 동작함
# 측정 ID는 반드시 'G-'로 시작해야 한다 (접두어가 빠지면 gtag가 조용히 실패)
NEXT_PUBLIC_GA_ID=G-7XRHSS9V0F

# 사이트 메타 — 정규 도메인은 www 포함. 코드 폴백(lib/site.ts)과 반드시 일치시킬 것
NEXT_PUBLIC_SITE_URL=https://www.wnjpower.com

# (선택) Google Search Console 소유확인 — HTML 태그 방식의 content 값만 넣는다.
#   <meta name="google-site-verification" content="여기만"> 형태에서 따옴표 안의 값.
#   비워 두면 meta 태그 자체가 붙지 않는다(빈 값을 넣으면 소유확인이 실패한다).
#   네이버 서치어드바이저 코드는 이미 app/layout.tsx에 박혀 있어 환경변수가 필요 없다.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── IndexNow (네이버 서치어드바이저 · Bing 자동 색인 제출) ──────────────────
# 글을 발행하면 자동으로 제출된다. 값을 비워도 코드에 있는 기본 키로 동작한다.
#
# ⚠️ 키를 바꾸려면 두 곳을 함께 바꿔야 한다:
#    1) 이 환경변수
#    2) public/<키>.txt 파일 이름과 내용 (검증용 키 파일)
#    둘이 어긋나면 제출이 403으로 거부된다.
INDEXNOW_KEY=7cc4061689dcd8a0e0b037335893d356
